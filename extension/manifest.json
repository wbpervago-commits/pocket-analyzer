{
  "manifest_version": 3,
  "name": "Pocket Analyzer History Experiment",
  "version": "0.2.9",
  "description": "Передаёт только исторические свечи Pocket Option; живые котировки остаются за Quote Bridge 1.0.0.",
  "minimum_chrome_version": "111",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*",
    "https://*.po.market/*",
    "https://wbpervago-commits.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*",
        "https://*.po.market/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://wbpervago-commits.github.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*",
        "https://*.po.market/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}